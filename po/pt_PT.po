msgid "Center mouse on focused display"
msgstr "Centrar o rato no ecrã em foco"

msgid "Center mouse on focused window"
msgstr "Centrar o rato na janela em foco"

msgid "Center pointer on focused display"
msgstr "Centrar o ponteiro no ecrã em foco"

msgid "Center pointer on focused window"
msgstr "Centrar o ponteiro na janela em foco"

#, javascript-format
msgid "Enter new shortcut to change <b>%s</b>"
msgstr "Introduzir novo atalho para <b>%s</b>"

msgid ""
"Keyboard shortcut to move the pointer to the center of the display that "
"contains the focused window."
msgstr ""
"Atalho de teclado para mover o ponteiro para o centro do ecrã que contém a "
"janela em foco."

msgid ""
"Keyboard shortcut to move the pointer to the center of the focused window."
msgstr ""
"Atalho de teclado para mover o ponteiro para o centro da janela em foco."

msgid "Not set"
msgstr "Não definido"

msgid "Press Esc to cancel or Backspace to disable the keyboard shortcut"
msgstr "Prima Esc para cancelar ou Backspace para desativar a tecla de atalho"

msgid "Reset to default"
msgstr "Repor predefinição"

msgid "Set Shortcut"
msgstr "Definir um atalho"

msgid "Set…"
msgstr "Definir…"

msgid "Shortcuts"
msgstr "Atalhos"
